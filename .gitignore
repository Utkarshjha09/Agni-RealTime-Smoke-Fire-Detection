*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Model: datasets, training runs and weights are build inputs/outputs.
# The rover downloads pretrained weights on its own — nothing here is vendored.
# ---------------------------------------------------------------------------
model/data/
model/datasets/
model/runs/
model/weights/
runs/
wandb/

# Weight and export formats, wherever they land
*.pt
*.pth
*.onnx
*.tflite
*.engine
*.param
*.bin
*_ncnn_model/

# ---------------------------------------------------------------------------
# Secrets and local config (ROVER_TOKEN, ROBOFLOW_API_KEY, …)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
secrets.json
*.pem

# ---------------------------------------------------------------------------
