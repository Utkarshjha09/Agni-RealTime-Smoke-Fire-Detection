# Agni rover service configuration.
#
# Copy to rover.env on the Pi, edit, then keep it out of git -- it holds the
# shared secret the app authenticates with.
#
#     cp rover.env.example rover.env
#     ROVER_TOKEN=$(openssl rand -hex 16) && sed -i "s/^ROVER_TOKEN=.*/ROVER_TOKEN=$ROVER_TOKEN/" rover.env
#
# deploy.sh writes this file for you with a generated token on a first deploy.

# -- Access -----------------------------------------------------------------
# The shared secret. Enter the identical value in the app's Settings screen.
# Empty means anyone on the network can drive the rover and sound the siren.
ROVER_TOKEN=
ROVER_NAME=Ranger-01
HTTP_PORT=8000

# -- Detector ---------------------------------------------------------------
# DETECTOR=1 runs the fire/smoke model in-process against the live camera.
DETECTOR=1
# Absolute path to the exported model on the Pi. deploy.sh sets this to the
# NCNN folder it copied. Leave empty to download pretrained weights from
# Hugging Face on first start instead.
MODEL_PATH=/home/pi/agni/model/best_nano_111_ncnn_model
# Must match the imgsz the model was exported at. export.py defaults to 640.
DETECT_IMGSZ=640
# Seconds between inference passes. 0.8 suits a Pi 4; lower it on a Pi 5.
DETECT_INTERVAL=0.8
# Minimum confidence the model itself reports before a box is considered.
DETECT_CONF=0.25
# CPU threads for the model. 2 leaves a Pi 4 a core each for the camera and
# the video stream; more threads made it slower, not faster, under load.
DETECT_THREADS=2

# -- Camera -----------------------------------------------------------------
# Frame rate of the live video stream (/stream.mjpg) the app shows. 15 is smooth
# to drive by and leaves a Pi 4 enough CPU for the detector.
STREAM_FPS=15
# Horizontal field of view in degrees, which the 3D view needs to turn a box
# position into a bearing. v2 = 62.2, v3 = 66, v3 Wide = 102.
CAMERA_HFOV=62.2
# White balance at start: auto, daylight, cloudy, indoor, tungsten or fluorescent.
# The app can change it live. Auto turned a white wall pink in testing.
CAMERA_AWB=daylight
# A libcamera tuning file. Set imx219_noir.json for a Camera Module v2 NoIR,
# which has no infrared filter and looks pink under the normal tuning.
CAMERA_TUNING=

# -- Motors -----------------------------------------------------------------
# Leave at 0 until you have checked the BCM pins in rover_server.py against
# your motor driver. 1 energises the wheels.
MOTOR_OUTPUT=0
# Normal and sprint duty ceilings, 0 to 1.
MAX_DUTY=0.65
SPRINT_DUTY=0.9
# Set to 1 if one side spins backwards relative to the other.
RIGHT_REVERSED=0
# Motors cut out this many seconds after the last command from the app.
CONTROL_TIMEOUT=0.45

# -- Optional outputs -------------------------------------------------------
# BCM pins, -1 when not wired. Independent of MOTOR_OUTPUT. The app only shows
# a button for a device whose pin is set here.
FLASH_PIN=-1
SIREN_PIN=-1
SIREN_HOLD=5.0

# -- Optional battery gauge -------------------------------------------------
# A shell command printing a percentage 0-100 on stdout. Unset means the app
# shows an em dash rather than a fabricated reading.
BATTERY_CMD=

# -- Optional ultrasonic range finder (HC-SR04) -----------------------------
# Both pins must be set for the sensor to start. ECHO needs a voltage divider:
# the Pi's GPIO is 3.3V and the HC-SR04 echoes at 5V. See README.md.
RANGE_TRIG_PIN=-1
RANGE_ECHO_PIN=-1
# Where the sensor points relative to the camera's centre line, in degrees.
RANGE_BEARING=0
RANGE_MAX_M=4.0
